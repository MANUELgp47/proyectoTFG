################################################ Actividades
###Crear actividad
POST http://localhost:3000/api/actividad
Content-Type: application/json

{
  "idCreador": 2,
  "titulo": "Billar x8",
  "descripcion": "Partida de billar para 8 personas.",
  "fechaInicio": "2025-11-09T09:00:00.000Z",
  "fechaFin": "2025-11-09T11:00:00.000Z",
  "ubicacion": "Madrid, España",
  "publica": false,
  "participantesmax": 4,
  "imagenes": [
    "https://example.com/img/padel.jpg"
  ],
  "estado": "activa"
}

