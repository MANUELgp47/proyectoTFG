#################################################### Participacion

###Actualizar el estadoetado
PUT http://localhost:3000/api/participacion/
Content-Type: application/json

{
  "idUsuario": 1,
  "idActividad": 2,
  "aceptada": true
}

###Crea participacion
POST http://localhost:3000/api/participacion
Content-Type: application/json

{
  "idUsuario": 3,
  "idActividad": 18

}

### Elimina participacion
DELETE http://localhost:3000/api/participacion/
Content-Type: application/json

{
  "idUsuario": 3,
  "idActividad": 12
}


######################################################## Notificaciones
###Crear notificacion
POST http://localhost:3000/api/notificacion
Content-Type: application/json

{
  "idUsuarioReceptor": 3,
  "tipo": "actividad_cancelada",
  "mensaje": "Se ha cancelado la actividad actividad llamada Cafe.",
  "leida": false,
  "idReferencia": 2
}


###Marcar notificacion como leida (actualizar)
PUT http://localhost:3000/api/notificacion/2
Content-Type: application/json

{
  "leida": true
}

###Eliminar notificacion
DELETE http://localhost:3000/api/notificacion/2


